# SR Automation Service - Environment Variables Sample
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control (already in .gitignore)

# ServiceNow Configuration
# Replace with your actual ServiceNow instance URL (e.g., yourcompany.service-now.com)
SERVICENOW_INSTANCE_URL=your-instance.service-now.com

# ServiceNow API Authentication
# Replace with your actual ServiceNow username and password
SERVICENOW_USERNAME=your_username
SERVICENOW_PASSWORD=your_password

# Environment Selection
# Options: "dev" or "prod"
# This determines which config file to load (configs/dev/config.yaml or configs/prod/config.yaml)
SERVICENOW_ENVIRONMENT=dev
